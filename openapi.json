{
  "openapi": "3.1.0",
  "info": {
    "title": "Delivery Fee Calculator",
    "version": "1.0.0",
    "description": "Calculates food courier delivery fees from a regional base fee, vehicle type and the latest weather."
  },
  "paths": {
    "/api/delivery-fee": {
      "get": {
        "summary": "Calculate delivery fee",
        "description": "Regional base fee + weather extra fee, using the latest weather observation at or before `dateTime`.",
        "parameters": [
          {
            "name": "city",
            "in": "query",
            "required": true,
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "string",
              "enum": [
                "TALLINN",
                "TARTU",
                "PARNU"
              ],
              "examples": [
                "TARTU"
              ]
            }
          },
          {
            "name": "vehicleType",
            "in": "query",
            "required": true,
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "string",
              "enum": [
                "CAR",
                "SCOOTER",
                "BIKE"
              ],
              "examples": [
                "BIKE"
              ]
            }
          },
          {
            "name": "dateTime",
            "in": "query",
            "required": false,
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "description": "ISO 8601 timestamp to calculate the fee for; defaults to now.",
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "examples": [
                "2026-10-15T09:00:00Z"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fee calculated",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "city": {
                      "type": "string",
                      "enum": [
                        "TALLINN",
                        "TARTU",
                        "PARNU"
                      ],
                      "examples": [
                        "TARTU"
                      ]
                    },
                    "vehicleType": {
                      "type": "string",
                      "enum": [
                        "CAR",
                        "SCOOTER",
                        "BIKE"
                      ],
                      "examples": [
                        "BIKE"
                      ]
                    },
                    "deliveryFee": {
                      "type": "number",
                      "minimum": 0,
                      "multipleOf": 0.01,
                      "description": "Amount in euros",
                      "examples": [
                        3.5
                      ]
                    }
                  },
                  "required": [
                    "city",
                    "vehicleType",
                    "deliveryFee"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "examples": [
                        "about:blank"
                      ]
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "detail": {
                      "type": "string"
